<mxfile host="drawio" agent="SysCon 2027 paper"><diagram name="pipeline" id="pipeline"><mxGraphModel dx="800" dy="300" grid="1" gridSize="1" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="540" pageHeight="140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="&lt;b&gt;1. Attributes and raw metrics&lt;/b&gt;&lt;br&gt;attributes from four documents, metrics for each" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=3;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4" y="30" width="90" height="50" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Debts&lt;/b&gt;&lt;br&gt;attributes that degrade together" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=3;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="111" y="30" width="90" height="50" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Static ontology&lt;/b&gt;&lt;br&gt;ML models and this knowledge in OWL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=3;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="218" y="30" width="90" height="50" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Model extraction&lt;/b&gt;&lt;br&gt;queries read the information of one model" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=3;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="325" y="30" width="90" height="50" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Monitoring&lt;/b&gt;&lt;br&gt;several metrics read together over time" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=3;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.8;fontFamily=Times New Roman;fontSize=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="432" y="30" width="90" height="50" as="geometry"/></mxCell><mxCell id="a1" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loop" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="16"/><mxPoint x="49" y="16"/></Array></mxGeometry></mxCell><mxCell id="loopl" value="iterate: when no debt explains an observed degradation, revise steps 1 and 2" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;fontFamily=Times New Roman;fontSize=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="59" y="2" width="408" height="12" as="geometry"/></mxCell><mxCell id="b1" style="endArrow=none;html=1;rounded=0;strokeColor=#000